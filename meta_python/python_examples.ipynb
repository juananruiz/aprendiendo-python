   "source": [
    "# Comprobar si dos listas tienen los mismos elementos aunque estén en distinto orden\n",
    "def are_lists_equal(lst1, lst2):\n",
    "    return len(lst1) == len(lst2) and sorted(lst1) == sorted(lst2)\n",
    "\n",
    "print(are_lists_equal([1, 3, 2, 4], [1, 2, 3, 4, 6]))"
   ]
